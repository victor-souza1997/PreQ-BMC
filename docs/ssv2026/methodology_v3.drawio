    <mxCell id="c1h" value="Off-target: formal verification of the C implementation (host)" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="600" height="34" as="geometry" /></mxCell>
    <mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1140" height="250" as="geometry" /></mxCell>
    <mxCell id="c2h" value="On-target: deployment and measurement (Khadas VIM3)" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=16;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="510" height="34" as="geometry" /></mxCell>
    <mxCell id="b1" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;1. Trained CNN&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;GTSRB, 43 classes&lt;br&gt;float32, 14,123 neurons&lt;br&gt;5 layers, depthwise L3&lt;br&gt;track-disjoint splits&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b2" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;2. Fixed-Point Quantization&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;Q7.8=(16,7,8), BN folded&lt;br&gt;round-half-away&lt;br&gt;clamp before ReLU&lt;br&gt;__int128 accumulators&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="74" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b3" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;3. Generated C Code&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;font-style:italic;color:#64748B;"&gt;deployment artifact&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;uint8 encoder (center)&lt;br&gt;integer net, int64&lt;br&gt;|acc| &amp;lt; 2^35 (static)&lt;br&gt;SHA-256 dd535f54...&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="74" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="phi" value="&lt;div style=&quot;font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;&quot;&gt;Specification &amp;#934;&lt;/div&gt;&lt;div style=&quot;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-style:italic;color:#64748B;&quot;&gt;used by finder and verifier&lt;/div&gt;&lt;div style=&quot;font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;&quot;&gt;&amp;#8704;x' &amp;#8712; {0..255}^3072&lt;br&gt;||x'&amp;#8722;x||&amp;#8734; &amp;#8804; 1 byte&lt;br&gt;f(x')_y &amp;#8722; f(x')_j &amp;#8805; 1&lt;br&gt;&amp;#8704; j &amp;#8800; y (42 classes)&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="74" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b4" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;4. Certificate Finder&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;font-style:italic;color:#64748B;"&gt;untrusted heuristic&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;interval boxes&lt;br&gt;exact-integer CROWN&lt;br&gt;linear bound chains&lt;br&gt;proposes bounds only&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="304" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b5" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;5. ESBMC Checking&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;font-style:italic;color:#64748B;"&gt;final judge&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;ESBMC 7.11, Z3, BV&lt;br&gt;encoder, non-vacuity&lt;br&gt;589 box blocks, lemmas&lt;br&gt;every chain step&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="304" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b6" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;6. Composition&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:14px;font-style:italic;color:#64748B;"&gt;trusted (Python), unverified&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;binds deployed arrays&lt;br&gt;SHA-256 identity&lt;br&gt;aggregates shards&lt;br&gt;&amp;#8594; per-image outcome&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#0F172A;strokeWidth=2;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="304" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="v1" value='&lt;span style="font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#0F172A;"&gt;&lt;b&gt;VERIFIED&lt;/b&gt;: every obligation VERIFIED&lt;/span&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="304" width="230" height="44" as="geometry" /></mxCell>
    <mxCell id="v2" value='&lt;span style="font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#0F172A;"&gt;&lt;b&gt;INCONCLUSIVE&lt;/b&gt;: margin &amp;lt; 1, or UNKNOWN (timeout / memory)&lt;/span&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="357" width="230" height="44" as="geometry" /></mxCell>
    <mxCell id="v3" value='&lt;span style="font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#0F172A;"&gt;&lt;b&gt;FAILED&lt;/b&gt;: a bound refuted; not a counterexample&lt;/span&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="410" width="230" height="44" as="geometry" /></mxCell>
    <mxCell id="cc" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;7. Cross-Compilation&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;aarch64-linux-gnu-gcc&lt;br&gt;-std=c11 -O2 -static&lt;br&gt;GCC 13.3, no NDK/JNI&lt;br&gt;source SHA-256 match&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b7" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;8. Khadas VIM3 (AAOS)&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;Android 16 pre-release&lt;br&gt;Cortex-A73, taskset 3c&lt;br&gt;adb shell, 1 thread&lt;br&gt;int64 / int16 / float32&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="620" y="580" width="230" height="150" as="geometry" /></mxCell>
    <mxCell id="b8" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:bold;color:#0F172A;line-height:1.15;"&gt;9. Evaluation&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:15px;color:#334155;margin-top:4px;line-height:1.2;"&gt;accuracy (validation)&lt;br&gt;integer-logit parity&lt;br&gt;median / p95 latency&lt;br&gt;peak RSS (1 image)&lt;/div&gt;' style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;shadow=0;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="910" y="580" width="230" height="150" as="geometry" /></mxCell>
