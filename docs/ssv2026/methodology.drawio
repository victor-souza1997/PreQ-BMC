    <mxCell id="c1h" value="Off-target: formal verification of the C implementation (host)" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="500" height="28" as="geometry" /></mxCell>
    <mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1400" height="180" as="geometry" /></mxCell>
    <mxCell id="c2h" value="On-target: deployment and measurement (Khadas VIM3)" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=11;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="500" height="28" as="geometry" /></mxCell>
    <mxCell id="b1" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;1. Trained CNN&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;GTSRB, 43 classes&lt;br&gt;float32, 14,123 neurons&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b2" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;2. Fixed-Point Quantization&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;Q7.8 = (16,7,8)&lt;br&gt;round-half-away&lt;br&gt;clamp before ReLU&lt;br&gt;__int128 accumulators&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b3" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;3. Generated C Code&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;uint8 byte encoder +&lt;br&gt;integer network&lt;br&gt;int64 storage&lt;br&gt;SHA-256 dd535f54...&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b4" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;4. Certificate Finder&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:9px;font-style:italic;color:#64748B;"&gt;untrusted&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;interval boxes +&lt;br&gt;exact-integer CROWN;&lt;br&gt;proposes bounds&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#B45309;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b5" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;5. ESBMC Checking&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:9px;font-style:italic;color:#64748B;"&gt;final judge&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;encoder, non-vacuity,&lt;br&gt;box blocks,&lt;br&gt;arithmetic lemmas&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#0F172A;strokeWidth=2;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b6" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;6. Composition&lt;/div&gt;&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:9px;font-style:italic;color:#64748B;"&gt;trusted (Python)&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;binding to deployed&lt;br&gt;arrays, SHA-256 identity&lt;br&gt;→ VERIFIED /&lt;br&gt;INCONCLUSIVE&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#0F172A;strokeWidth=2;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b7" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;7. Khadas VIM3 (AAOS)&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;Cortex-A73 cluster&lt;br&gt;static AArch64 binaries&lt;br&gt;via adb&lt;br&gt;certified int64,&lt;br&gt;float32 baseline&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="520" y="360" width="160" height="90" as="geometry" /></mxCell>
    <mxCell id="b8" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:11px;font-weight:bold;color:#0F172A;"&gt;8. Evaluation&lt;/div&gt;&lt;div style="font-family:Courier New,monospace;font-size:9px;color:#334155;margin-top:3px;"&gt;accuracy (validation)&lt;br&gt;integer-logit parity&lt;br&gt;vs host&lt;br&gt;median / p95 latency&lt;br&gt;peak RSS&lt;/div&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;shadow=0;fillColor=#F1F5F9;strokeColor=#334155;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=4;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="160" height="90" as="geometry" /></mxCell>
