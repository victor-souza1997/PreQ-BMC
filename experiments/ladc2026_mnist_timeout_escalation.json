{
  "metadata": {
    "description": "Targeted MNIST ESBMC timeout escalation for the monolithic and beta=10 frontier",
    "reproduce_command": "preqbmc reproduce --config experiments/ladc2026_mnist_timeout_escalation.json --aggregate",
    "output_root": "output/ladc2026_mnist_timeout_escalation_runs",
    "input_root": "output/ladc2026_mnist_timeout_escalation_runs",
    "aggregate_output_root": "output/ladc2026_mnist_timeout_escalation_results",
    "source_campaign": "experiments/ladc2026_experiment_matrix.json",
    "notes": [
      "This is a targeted T11 escalation, not a replacement for the 300-second matrix results.",
      "It uses MNIST 1blk_10, 2blk_10_10, and 1blk_25, sample 3, raw-pixel epsilon 0.25. At these regions, beta=1, beta=2, and beta=5 verified in the completed 300-second matrix, making them the strongest available candidates for testing beta=0 and beta=10.",
      "The two runs differ only in hidden-layer verification decomposition: beta=0 is monolithic and beta=10 is one full hidden-layer block. Both retain one shared Q/I/F per layer.",
      "The format search remains Q=3..40 to match the primary matrix. The monolithic beta=0 run has a 1200-second per-query budget; beta=10 and larger blocks have a 900-second per-query budget; beta=1, beta=2, and beta=5 use 300 seconds per query.",
      "The clamp is part of every ESBMC contract harness and matches generated deployment C. Formal no-saturation is therefore an optional stronger property and is disabled here; empirical saturation diagnostics remain enabled.",
      "The 100-neuron entries are staged scalability-frontier experiments. Enable 1blk_100 explicitly before 2blk_100_100, and retain all non-VERIFIED outcomes as results.",
      "Only final_status=VERIFIED with guarantee_level=deployed-transfer counts as certification. TIMEOUT, MEMOUT, UNKNOWN, and other inconclusive outcomes are results."
    ]
  },
  "defaults": {
    "bit_lb": 3,
    "bit_ub": 40,
    "preimg_mode": "milp",
    "verify_mode": "esbmc",
    "solver": "cbc",
    "method": "both",
    "mode": "derived_layer_contract_verified_bounds_timeout_escalation",
    "compare_split": "test",
    "compare_limit": 0,
    "compile_c_backend": true,
    "enable_diagnostics": true,
    "export_paper_tables": true,
    "error_budget_mode": "derived",
    "tighten_verified_bounds": true,
    "cex_feedback": "filter+jump",
    "harness_scope": "layer",
    "margin_cuts": "on",
    "e2e_invariants": true,
    "cegar_max_rounds": 3,
    "e2e_fallback": "off",
    "vacuity_check": true,
    "unsound_contract_tolerance": false,
    "propagate_contract_tolerance": false,
    "enforce_contract_chaining": true,
    "quality_refinement": false,
    "max_quality_refinement_steps": 0,
   "formal_no_saturation": true,
    "require_formal_no_saturation": true,
    "no_saturation_continue_on_unknown": false,
    "empirical_saturation_check": true,
    "accuracy_drop_threshold": 0.05,
    "saturation_threshold": 0.01,
    "mismatch_threshold": 0.05,
    "esbmc_profile": "paper-z3",
    "esbmc_timeout_seconds": 300,
    "esbmc_memlimit": "20g",
    "esbmc_jobs": 1,
    "blockwise_fail_fast": false,
    "blockwise_run_all_blocks_on_failure": true,
    "gurobi_threads": 4,
    "allowed_failure": true,
    "enabled": true
  },
  "runs": [
    {
      "name": "ladc_t11_mnist_1blk10_sample3_eps0p25_monolithic_timeout1200",
      "dataset": "mnist",
      "arch": "1blk_10",
      "sample_id": 3,
      "eps": 0.25,
      "esbmc_layer_block_size": 0,
      "esbmc_timeout_seconds": 1200,
      "mode": "full_layer_timeout1200",
      "experiment_arm": "D",
      "expected_difficulty": "frontier",
      "notes": "Matched monolithic beta=0 escalation from the 300-second timeout outcome."
    },
