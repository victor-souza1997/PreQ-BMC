{
  "schema": "ssv_deep_source_model_search_v1",
  "dataset": "gtsrb_official",
  "base_study": "output/plate_experiments/study.json",
  "preprocessing": {
    "input_domain": "uint8_RGB_cropped_sign",
    "shape": [32, 32, 3],
    "resize": "nearest_center",
    "normalization_divisor": 256,
    "tie_break": "lowest_class_index"
  },
  "classes": 43,
  "max_affine_entries": 30000000,
  "minimum_available_memory_mib": 12288,
  "training": {
    "seed": 2032,
    "split_seed": 2026,
    "epochs": 100,
    "batch_size": 64,
    "validation_fraction": 0.2,
    "learning_rate": 0.001,
    "minimum_learning_rate": 0.00001,
    "weight_decay": 0.0001,
    "early_stopping_patience": 12,
    "early_stopping_monitor": "val_accuracy",
    "lr_plateau_patience": 4,
    "class_weighting": "none",
    "augmentation": {
      "translation_fraction": 0.1,
      "contrast_factor": 0.2,
      "rotation_fraction": 0.03,
      "zoom_fraction": 0.1
    }
  },
  "selection": {
    "minimum_validation_accuracy": 0.9,
    "rule": "ordered_first_passing",
    "test_set_policy": "evaluate_once_after_selection"
  },
  "candidates": [
    {
      "id": "conv24_48_128_avg2_43",
      "conv_blocks": [
        {"filters": 24, "kernel_size": [5, 5], "strides": [2, 2], "padding": "SAME"},
        {"filters": 48, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"},
        {"filters": 128, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"}
      ],
      "dense_hidden": [],
      "average_pool_size": [2, 2],
      "dropout_rates": [0.1, 0.15, 0.2]
    },
    {
      "id": "conv24_64_192_avg2_43",
      "conv_blocks": [
        {"filters": 24, "kernel_size": [5, 5], "strides": [2, 2], "padding": "SAME"},
        {"filters": 64, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"},
        {"filters": 192, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"}
      ],
      "dense_hidden": [],
      "average_pool_size": [2, 2],
      "dropout_rates": [0.1, 0.15, 0.2]
    },
    {
      "id": "conv28_64_192_avg2_43",
      "conv_blocks": [
        {"filters": 28, "kernel_size": [5, 5], "strides": [2, 2], "padding": "SAME"},
        {"filters": 64, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"},
        {"filters": 192, "kernel_size": [3, 3], "strides": [2, 2], "padding": "SAME"}
      ],
      "dense_hidden": [],
      "average_pool_size": [2, 2],
      "dropout_rates": [0.1, 0.15, 0.2]
    }
  ]
}
