{
  "metadata": {
    "description": "MNIST small-block pilot with verified affine-bound propagation",
    "reproduce_command": "preqbmc reproduce --config experiments/mnist_verified_bounds_small_blocks.json --aggregate",
    "output_root": "output/mnist_verified_bounds_small_blocks_runs",
    "input_root": "output/mnist_verified_bounds_small_blocks_runs",
    "aggregate_output_root": "output/mnist_verified_bounds_small_blocks_results",
    "notes": [
      "This pilot uses only the 10-neuron MNIST architectures.",
      "Block sizes 1, 2, and 5 are verification decompositions only; every block uses the same shared Q/I/F selected for its layer.",
      "The output layer remains unsplit.",
      "The MILP preimage, derived error budget, enforced chaining, vacuity guard, and exact output-margin harness remain enabled.",
      "Verified affine bounds are propagated only after all hidden-layer blocks pass.",
      "F=8 is fixed to isolate block-size scalability from precision search.",
      "MNIST epsilon is expressed in raw pixel units; 0.25 corresponds to approximately 0.000980392 after normalization.",
      "Only final_status=VERIFIED with guarantee_level=deployed-transfer is counted as certified."
    ]
  },
  "defaults": {
    "bit_lb": 8,
    "bit_ub": 8,
    "preimg_mode": "milp",
    "verify_mode": "esbmc",
    "solver": "cbc",
    "method": "both",
    "mode": "derived_layer_contract_verified_bounds",
    "compare_split": "test",
    "compare_limit": 0,
    "compile_c_backend": true,
    "enable_diagnostics": true,
    "export_paper_tables": true,
    "error_budget_mode": "derived",
    "tighten_verified_bounds": true,
    "cex_feedback": "filter+jump",
    "harness_scope": "layer",
    "margin_cuts": "on",
    "cegar_max_rounds": 3,
    "e2e_fallback": "off",
    "vacuity_check": true,
    "unsound_contract_tolerance": false,
    "propagate_contract_tolerance": false,
    "enforce_contract_chaining": true,
    "quality_refinement": false,
    "max_quality_refinement_steps": 0,
    "formal_no_saturation": false,
    "require_formal_no_saturation": false,
    "empirical_saturation_check": true,
    "accuracy_drop_threshold": 0.05,
    "saturation_threshold": 0.01,
    "mismatch_threshold": 0.05,
    "esbmc_profile": "paper-z3",
    "esbmc_timeout_seconds": 300,
    "esbmc_memlimit": "6g",
    "esbmc_jobs": 1,
    "blockwise_fail_fast": true,
    "blockwise_run_all_blocks_on_failure": false,
    "no_saturation_continue_on_unknown": false,
    "gurobi_threads": 4,
    "allowed_failure": true,
    "enabled": true
  },
  "runs": [
    {
      "name": "mnist_1blk10_verified_bounds",
      "dataset": "mnist",
      "arch": "1blk_10",
      "sample_ids": [3, 2228, 9389],
      "eps": 0.25,
      "esbmc_layer_block_sizes": [1, 2, 5],
      "expected_difficulty": "medium",
      "notes": "Primary small-network block-size comparison."
    },
    {
      "name": "mnist_2blk10_verified_bounds",
      "dataset": "mnist",
      "arch": "2blk_10_10",
      "sample_ids": [3],
      "eps": 0.25,
      "esbmc_layer_block_sizes": [1, 2, 5],
      "expected_difficulty": "high",
      "notes": "Deeper-network feasibility probe using the established sample 3 anchor."
    }
  ]
}
